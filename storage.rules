rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    // ===============================================================
    // Target architecture: UID-scoped quarantine upload paths only.
    // ===============================================================
    //
    // Flutter may upload files ONLY to private, UID-scoped quarantine
    // paths after Laravel authorizes an upload intent. The path pattern
    // is quarantine/{uid}/... and the authenticated UID must match.
    //
    // Originals (panoramas, product photos, store images) are uploaded to
    // quarantine and remain private. Laravel verifies, processes, and
    // controls publication of sanitized derivatives.
    //
    // Clients cannot:
    //   - Read raw originals (private staging)
    //   - Write to published/sanitized paths (Laravel-controlled)
    //   - Upload without authentication
    //   - Upload to a path owned by another user

    // ── Quarantine uploads: authenticated UID must match path ─────────
    // Products: quarantine/{uid}/products/{uploadId}/original.jpg
    match /quarantine/{uid}/products/{allPaths=**} {
      allow read: if false;  // originals are private — Laravel-only access
      allow write: if signedIn() &&
        request.auth.uid == uid &&
        request.resource.contentType.matches('image/(jpeg|jpg|png|webp)') &&
        request.resource.size < 10 * 1024 * 1024;  // 10 MB max
    }

    // Tours (panoramas): quarantine/{uid}/tours/{uploadId}/original.jpg
    match /quarantine/{uid}/tours/{allPaths=**} {
      allow read: if false;  // originals are private — Laravel-only access
      allow write: if signedIn() &&
        request.auth.uid == uid &&
        request.resource.contentType.matches('image/(jpeg|jpg|png)') &&
        request.resource.size < 50 * 1024 * 1024;  // 50 MB max panorama
    }

    // Store images: quarantine/{uid}/stores/{uploadId}/original.jpg
    match /quarantine/{uid}/stores/{allPaths=**} {
      allow read: if false;
      allow write: if signedIn() &&
        request.auth.uid == uid &&
        request.resource.contentType.matches('image/(jpeg|jpg|png|webp)') &&
        request.resource.size < 10 * 1024 * 1024;
    }

    // ── Published/sanitized derivatives: read-only for clients ────────
    // Only Laravel (via IAM/signed URLs) writes to these paths.
    // Approved product images
    match /products/{allPaths=**} {
      allow read: if true;  // public approved derivatives
      allow write: if false;  // Laravel-controlled publication only
    }

    // Published store images
    match /stores/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Published 360° tour panorama tiles/derivatives
    match /tours/public/{allPaths=**} {
      allow read: if true;  // sanitized derivatives are public
      allow write: if false;  // Laravel-controlled publication only
    }

    // Private tour originals (retention period)
    match /tours/originals/{allPaths=**} {
      allow read, write: if false;  // Laravel/IAM-only access
    }

    // ── Deny everything else ──────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
