<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Configuration for LocalSpot.

  Development: allows cleartext (HTTP) traffic to the Android emulator
  host (10.0.2.2), localhost, and local LAN addresses (192.168.x.x,
  10.0.x.x, 172.16-31.x.x) so the app can reach a development Laravel
  server running on the developer's machine.

  Production: all other domains must use HTTPS. The Laravel API must
  be served over HTTPS in production (e.g., https://api.localspot.ph).

  This config replaces the blanket android:usesCleartextTraffic="true"
  which allowed HTTP to any host.
-->
<network-security-config>
    <!-- Development: allow cleartext to emulator host and localhost -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>

    <!-- Development: allow cleartext to local LAN IPs for physical device testing -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- Common private network ranges for physical device development -->
        <domain includeSubdomains="false">192.168.0.0</domain>
        <domain includeSubdomains="false">192.168.1.0</domain>
        <!-- Add your specific LAN IP here during development, e.g.:
        <domain includeSubdomains="false">192.168.1.58</domain>
        -->
    </domain-config>

    <!-- Production: HTTPS only for all other domains -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
