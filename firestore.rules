rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Target architecture: deny-by-default for business collections.
    // ===============================================================
    //
    // In the finalized architecture, Flutter does NOT directly read or
    // write Firestore business collections. All application reads and
    // writes go through the Laravel REST API, which verifies Firebase ID
    // tokens, enforces authorization, and accesses Firestore through its
    // server client (IAM/ADC — bypasses these rules).
    //
    // These rules deny direct client access to business data. The Laravel
    // server client is not subject to these rules (it authenticates via
    // Google IAM), so business operations still work through the API.
    //
    // The only direct client access allowed is:
    //   - users/{uid}: a user can read their own profile (created by Laravel)
    //   - vendorLocationSessions: public read for the live-vendor map
    //
    // Collection names follow the canonical naming from the development plan:
    //   storeListings (not listings), storeTours (not tours),
    //   vendorLocationSessions (not vendorSessions)

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // ── User profile: self-read only, writes through Laravel ───────────
    match /users/{uid} {
      allow read: if isOwner(uid);
      // Profile is created/managed by Laravel (server client). Clients
      // must not self-assign roles or grants.
      allow create, update, delete: if false;
    }

    // ── Business collections: denied for direct client access ──────────
    // All reads and writes go through Laravel API endpoints.

    match /stores/{storeId} {
      allow read, write: if false;
    }

    match /storeListings/{listingId} {
      allow read, write: if false;
    }

    // Legacy name kept for migration compatibility.
    match /listings/{listingId} {
      allow read, write: if false;
    }

    match /products/{productId} {
      allow read, write: if false;
    }

    match /productAliases/{aliasId} {
      allow read, write: if false;
    }

    match /categories/{categoryId} {
      allow read, write: if false;
    }

    match /categorySynonyms/{synonymId} {
      allow read, write: if false;
    }

    match /productAttributeSchemas/{schemaId} {
      allow read, write: if false;
    }

    match /promotions/{promotionId} {
      allow read, write: if false;
    }

    match /storeTours/{tourId} {
      allow read, write: if false;
    }

    // Legacy name kept for migration compatibility.
    match /tours/{tourId} {
      allow read, write: if false;
    }

    match /storeTours/{tourId}/nodes/{nodeId} {
      allow read, write: if false;
    }

    match /storeTours/{tourId}/connections/{connectionId} {
      allow read, write: if false;
    }

    match /storeMembers/{memberId} {
      allow read, write: if false;
    }

    match /stockMovements/{movementId} {
      allow read, write: if false;
    }

    match /productRecognitionJobs/{jobId} {
      allow read, write: if false;
    }

    match /mediaAssets/{assetId} {
      allow read, write: if false;
    }

    match /favorites/{favoriteId} {
      allow read, write: if false;
    }

    match /reports/{reportId} {
      allow read, write: if false;
    }

    match /feedback/{feedbackId} {
      allow read, write: if false;
    }

    match /auditLogs/{logId} {
      allow read, write: if false;
    }

    match /searchOutbox/{eventId} {
      allow read, write: if false;
    }

    // ── Vendor location sessions: public read for live map ─────────────
    // Active sessions are publicly readable so customers can see mobile
    // vendor locations on the map. Writes are through Laravel only.
    match /vendorLocationSessions/{sessionId} {
      allow read: if true;
      allow write: if false;
    }

    // Legacy name kept for migration compatibility.
    match /vendorSessions/{sessionId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
