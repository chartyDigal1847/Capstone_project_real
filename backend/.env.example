APP_NAME=LocalSpot
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ───────────────────────────────────────────────────────────────
# Firebase Configuration (target architecture)
# ───────────────────────────────────────────────────────────────
# Firebase project ID — used for Auth token verification, Firestore, and Storage.
FIREBASE_PROJECT_ID=capstone-project-561a2

# Firestore — official PHP client uses gRPC + ADC/IAM (bypasses Security Rules).
# Leave FIRESTORE_EMULATOR_HOST empty in production.
FIRESTORE_EMULATOR_HOST=
GOOGLE_APPLICATION_CREDENTIALS=

# Firebase Auth — token verification uses RS256 JWT against Google's public keys.
# Set FIREBASE_AUTH_EMULATOR_HOST only for local/test emulator (enables test-token bypass).
FIREBASE_AUTH_EMULATOR_HOST=

# Cloud Storage — for media upload intents and signed download URLs.
FIREBASE_STORAGE_BUCKET=
FIREBASE_STORAGE_EMULATOR_HOST=

# ───────────────────────────────────────────────────────────────
# Local development with Firebase Emulator Suite (Docker → host)
# ───────────────────────────────────────────────────────────────
# FIRESTORE_EMULATOR_HOST=host.docker.internal:8080
# FIREBASE_AUTH_EMULATOR_HOST=host.docker.internal:9099
# FIREBASE_STORAGE_EMULATOR_HOST=host.docker.internal:9199
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/serviceAccountKey.json
# GOOGLE_CLOUD_PROJECT=capstone-project-561a2

# ───────────────────────────────────────────────────────────────
# Queue / Cache — use Redis, not MySQL database driver, in target architecture
# ───────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Optional OSRM-compatible routing base. Empty = local straight-line preview.
# Supported providers:
#   OpenRouteService: https://api.openrouteservice.org/v2/directions/driving-car
#   Self-hosted OSRM: http://localhost:5000
#   Set ROUTING_PROVIDER=openrouteservice and ROUTING_API_KEY for ORS.
ROUTING_BASE_URL=
ROUTING_PROVIDER=
ROUTING_API_KEY=
VENDOR_SESSION_MINUTES=120
